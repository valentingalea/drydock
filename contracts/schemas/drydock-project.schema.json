{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drydock:schema:project:1",
  "title": "Drydock Project Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "drydockContract",
    "product",
    "host",
    "components",
    "runtime",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "drydockContract": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "executableName",
        "appId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "executableName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "appId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "requiredCapabilities"
      ],
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "storage",
              "achievements",
              "telemetry",
              "purchases",
              "identity"
            ]
          }
        }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "revision"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "enum": [
              "project",
              "gitlink"
            ]
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "entries"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "source",
              "target"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "overlay": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "const": "artifacts"
        }
      }
    }
  }
}
