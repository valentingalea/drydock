{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drydock:schema:artifact:3",
  "title": "Drydock Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releasable",
    "productId",
    "version",
    "buildNumber",
    "buildAdapter",
    "platform",
    "arch",
    "artifactRoot",
    "signing",
    "capabilities",
    "checksums",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "releasable": {
      "type": "boolean"
    },
    "productId": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "buildNumber": {
      "type": "integer",
      "minimum": 0
    },
    "buildAdapter": {
      "$ref": "#/$defs/identifier"
    },
    "platform": {
      "enum": [
        "windows",
        "linux",
        "macos",
        "ios",
        "android",
        "web"
      ]
    },
    "arch": {
      "enum": [
        "x64",
        "arm64",
        "universal",
        "wasm"
      ]
    },
    "artifactRoot": {
      "$ref": "#/$defs/portablePath"
    },
    "executable": {
      "anyOf": [
        {
          "$ref": "#/$defs/portablePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "bundleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "packageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsigned",
            "signed",
            "notarized",
            "provisioned",
            "unknown"
          ]
        },
        "identity": {
          "type": "string"
        },
        "notarized": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage",
          "cloudSave",
          "achievements",
          "telemetry",
          "purchases",
          "identity",
          "overlay",
          "entitlementCheck"
        ]
      }
    },
    "checksums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checksum"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "drydock",
        "release",
        "components",
        "adapter",
        "channelPolicy"
      ],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "descriptor",
            "commit"
          ],
          "properties": {
            "descriptor": {
              "$ref": "#/$defs/checksummedInput"
            },
            "commit": {
              "$ref": "#/$defs/gitCommit"
            },
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "drydock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit"
          ],
          "properties": {
            "commit": {
              "$ref": "#/$defs/gitCommit"
            }
          }
        },
        "release": {
          "$ref": "#/$defs/checksummedInput"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "revision",
              "commit"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/portablePath"
              },
              "revision": {
                "enum": [
                  "project",
                  "gitlink"
                ]
              },
              "commit": {
                "$ref": "#/$defs/gitCommit"
              }
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "package",
            "profile"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "enum": [
                "development",
                "release"
              ]
            }
          }
        },
        "channelPolicy": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "channel",
                "path",
                "sha256",
                "snapshot"
              ],
              "properties": {
                "channel": {
                  "$ref": "#/$defs/identifier"
                },
                "path": {
                  "$ref": "#/$defs/portablePath"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "snapshot": {
                  "type": "object"
                }
              }
            }
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releasable": {
            "const": true
          }
        },
        "required": [
          "releasable"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "adapter": {
                "type": "object",
                "properties": {
                  "profile": {
                    "const": "release"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "not": {
            "pattern": "[<>:\"|?*\\u0000-\\u001F]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?!\\.(?:/|$))[^/]*[. ](?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "^\\./|//|/\\.(?:/|$)|/$"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "algorithm",
        "value"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "algorithm": {
          "enum": [
            "sha256",
            "sha512"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{128}$"
              }
            }
          }
        }
      ]
    },
    "checksummedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
