{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drydock.dev/schemas/drydock-product.schema.json",
  "title": "Drydock Product Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productId",
    "productName",
    "executableName",
    "appId",
    "entrypoint",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "productName": {
      "type": "string",
      "minLength": 1
    },
    "executableName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^product/.+"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "overlay": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
