drydock.example.com {
	encode gzip zstd

	root * {$DRYDOCK_WEB_ROOT:/srv/drydock/web}

	@allowed path / /index.html /host-bridge.js /vendor/drydock-host-bridge/* /product/*
	handle @allowed {
		file_server
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/drydock-release-access.log
	}
}
