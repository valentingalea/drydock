existing.example.com {
	encode gzip zstd

	redir /drydock-release /drydock-release/ 308
	handle_path /drydock-release/* {
		root * /var/www/drydock

		@drydock_release_allowed path / /index.html /host-bridge.js /src/* /assets/* /vendor/*
		handle @drydock_release_allowed {
			try_files {path} /index.html
			file_server
		}

		handle {
			respond 404
		}
	}
}
