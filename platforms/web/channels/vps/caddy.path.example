existing.example.com {
	encode gzip zstd

	redir /{$DRYDOCK_ROUTE} /{$DRYDOCK_ROUTE}/ 308
	handle_path /{$DRYDOCK_ROUTE}/* {
		root * {$DRYDOCK_WEB_ROOT}

		@private path /package.json /.git/* /shipping/* /drydock-artifact.json /.drydock-channel
		handle @private {
			respond 404
		}

		file_server
	}
}
