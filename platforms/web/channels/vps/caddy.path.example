existing.example.com {
	encode gzip zstd

	redir /drydock-release /drydock-release/ 308
	handle_path /drydock-release/* {
		root * {$DRYDOCK_WEB_ROOT:/srv/drydock/web}

		@drydock_release_allowed path / /index.html /host-bridge.js /vendor/drydock-host-bridge/* /product/*
		handle @drydock_release_allowed {
			file_server
		}

		handle {
			respond 404
		}
	}
}
