{$DRYDOCK_HOSTNAME} {
	encode gzip zstd

	redir /{$DRYDOCK_DOWNLOAD_ROUTE} /{$DRYDOCK_DOWNLOAD_ROUTE}/ 308
	handle_path /{$DRYDOCK_DOWNLOAD_ROUTE}/* {
		root * {$DRYDOCK_DOWNLOAD_ROOT}

		@drydock_downloads_allowed path / /index.html /*.zip /*.zip.sha256
		handle @drydock_downloads_allowed {
			header Cache-Control "no-store"
			file_server
		}

		handle {
			respond 404
		}
	}
}
