# Optional Windows code signing inputs for direct-download builds.
# Real values go in secrets.enc.yaml via SOPS+age, never in this file.

# Classic Authenticode / electron-builder PFX path or base64-encoded PFX.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Optional Azure Trusted Signing service-principal credentials.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional Azure Trusted Signing config values for electron-builder win.azureSignOptions.
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=
AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=
