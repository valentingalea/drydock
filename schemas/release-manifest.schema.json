{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drydock.dev/schemas/release-manifest.schema.json",
  "title": "Drydock Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "build",
    "channels"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "branch": {
            "type": "string"
          },
          "track": {
            "type": "string"
          },
          "sandbox": {
            "type": "string"
          },
          "submitForReview": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
